{
  "version": 6,
  "configurePresets": [
    {
      "name": "uwp-common",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "WindowsStore",
        "CMAKE_SYSTEM_VERSION": "10.0",
        "BLOCKCRAFT_SDL_ROOT": "C:/path/to/sdl2-install",
        "BLOCKCRAFT_LOVE_BUILD": "${sourceDir}/../engine/love-xbox-uwp-main/build/uwp-x64-angle/RelWithDebInfo"
      }
    },
    {
      "name": "uwp-relwithdebinfo",
      "inherits": "uwp-common",
      "displayName": "Blockcraft Xbox UWP (RelWithDebInfo)",
      "binaryDir": "${sourceDir}/build/relwithdebinfo"
    },
    {
      "name": "uwp-release",
      "inherits": "uwp-common",
      "displayName": "Blockcraft Xbox UWP (Release)",
      "binaryDir": "${sourceDir}/build/release"
    }
  ],
  "buildPresets": [
    {
      "name": "uwp-relwithdebinfo",
      "configurePreset": "uwp-relwithdebinfo",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    },
    {
      "name": "uwp-release",
      "configurePreset": "uwp-release",
      "configuration": "Release",
      "jobs": 8
    }
  ]
}
